rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isCoach() {
      return isSignedIn() && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    function isCoachOfStudent(studentUid) {
      return isCoach()
        && exists(/databases/$(database)/documents/students/$(studentUid))
        && get(/databases/$(database)/documents/students/$(studentUid)).data.coachId == request.auth.uid;
    }
    // bulkAdd.js'in kendi kataloğa-zorunlu moduna geçebilmesi için: bu hesap
    // GERÇEKTEN bir hocaya bağlı öğrenci mi (students/{kendi uid'i} var mı).
    function isManagedStudent() {
      return isSignedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }
    // isCoachOfStudent'ın tersi: öğrenci kendi hocasının doc'unu (sadece ismini
    // göstermek için) okuyabilsin mi. Ayarlar ekranındaki "Hocan: ..." satırı için.
    function isMyCoach(coachUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.coachId == coachUid;
    }
    // Admin, güvendiği belirli bir hocaya (kendi coaches/{uid} dokümanındaki bir
    // bayrakla, toggle'la açılıp kapanan) paylaşılan egzersiz kataloğunu YAZMA
    // izni verebiliyor — .get(...,false) eski/hiç ayarlanmamış hocalarda alan
    // yoksa hata fırlatmak yerine sessizce false dönüyor.
    function canManageCatalog() {
      return isCoach()
        && get(/databases/$(database)/documents/coaches/$(request.auth.uid)).data.get('canManageCatalog', false) == true;
    }
    // canManageCatalog()'un aynı deseni, ayrı bir bayrak — hedef bölge listesini
    // yönetme izni kataloğu yönetme izninden BAĞIMSIZ, admin ikisini ayrı ayrı verip alabiliyor.
    function canManageRegions() {
      return isCoach()
        && get(/databases/$(database)/documents/coaches/$(request.auth.uid)).data.get('canManageRegions', false) == true;
    }

    // ---- Mevcut kullanıcı verisi: DEĞİŞMEDİ, sadece bir OR ile genişledi ----
    // request.auth.uid == userId satırı hiç dokunulmadan aynı kaldı; isCoachOfStudent
    // SADECE bir hoca istek yaptığında çalışıyor, || kısa-devre yaptığı için mevcut
    // hesabın (ve her öğrencinin kendi verisinin) davranışı/maliyeti birebir aynı.
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == userId ||
        isCoachOfStudent(userId)
      );
    }

    // ---- admins: yalnızca Console/Admin SDK yazabilir (ikisi de rule'ları bypass eder) ----
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ---- coaches: doc ID = hocanın gerçek uid'i. Sadece geçerli, pending bir
    // coachInvites token'ı sunularak (join.html'in runTransaction'ı içinde) oluşturulabilir. ----
    match /coaches/{coachUid} {
      allow get: if isSignedIn() && (request.auth.uid == coachUid || isMyCoach(coachUid));
      allow list: if isAdmin();
      // NOT: 'pending' değil 'claimed'e (ve claimedUid'in BENİM olduğuna) bakıyoruz,
      // getAfter() ile — yani bu create'in, coachInvites'ı claim'e geçiren
      // tx.update ile AYNI transaction/batch içinde gitmesi ZORUNLU. Tek başına
      // (davete hiç dokunmadan) bir coaches/{uid} yazmaya çalışmak artık reddedilir
      // — eskiden sadece "davet pending mi" bakıyordu, aynı hiç-tüketilmeyen
      // davetle sınırsız sayıda hesap oluşturmaya açıktı (bkz. denetim notu).
      allow create: if isSignedIn()
        && request.auth.uid == coachUid
        && request.resource.data.inviteToken is string
        && getAfter(/databases/$(database)/documents/coachInvites/$(request.resource.data.inviteToken)).data.status == 'claimed'
        && getAfter(/databases/$(database)/documents/coachInvites/$(request.resource.data.inviteToken)).data.claimedUid == request.auth.uid;
      // Admin'in "Egzersiz Kütüphanesi"/"Hedef Bölgeler" toggle'ları için dar bir
      // istisna — SADECE bu iki izin alanını değiştirebiliyor, başka hiçbir alanı değiştiremez.
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canManageCatalog', 'canManageRegions']);
      // "Hesabımı sil" özelliği için: SADECE kendi kaydını silebilir. Bağlı
      // öğrencileri varsa bu silinmez/etkilenmez — uygulama tarafı buna göre
      // uyarı gösteriyor ama rules seviyesinde engellemiyoruz (bir koleksiyonda
      // "başka hiçbir doküman bana referans vermiyor" diye sorgu yapılamıyor).
      allow delete: if isSignedIn() && request.auth.uid == coachUid;
    }

    // ---- coachInvites: admin oluşturur, token bilen HERKES (auth'suz) 'get' edebilir
    // (join.html davet edenin adını göstermek için okuyor), claim tek yönlü geçiş. ----
    match /coachInvites/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedUid == request.auth.uid
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    // ---- students: doc ID = öğrencinin gerçek uid'i. coachId create anında
    // studentInvites'daki değerle eşleşmek ZORUNDA (yoksa geçerli bir davetle
    // "yanlış" hocaya bağlanma açığı olurdu). ----
    match /students/{studentUid} {
      allow get: if isSignedIn() && (request.auth.uid == studentUid || isCoachOfStudent(studentUid) || isAdmin());
      // list/count: her hoca SADECE kendi coachId'siyle filtrelenmiş sorguyu görebilir
      // (Firestore, resource.data üzerinden bu filtreyi fiilen zorunlu kılar); admin
      // hoca roster'ındaki öğrenci sayılarını görmek için hepsini sayabilir.
      allow list: if (isCoach() && resource.data.coachId == request.auth.uid) || isAdmin();
      // Aynı getAfter() sıkılaştırması coaches'daki gibi — bkz. o yorum.
      allow create: if isSignedIn()
        && request.auth.uid == studentUid
        && request.resource.data.inviteToken is string
        && request.resource.data.coachId is string
        && getAfter(/databases/$(database)/documents/studentInvites/$(request.resource.data.inviteToken)).data.status == 'claimed'
        && getAfter(/databases/$(database)/documents/studentInvites/$(request.resource.data.inviteToken)).data.claimedUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/studentInvites/$(request.resource.data.inviteToken)).data.coachId == request.resource.data.coachId;
      allow update: if false;
      // "Hesabımı sil" özelliği için: SADECE kendi kaydını silebilir (başka
      // hiç kimse, koçu dahil, bir öğrenciyi bu yoldan silemiyor).
      allow delete: if isSignedIn() && request.auth.uid == studentUid;
    }

    // ---- studentInvites: sadece daveti oluşturan hoca yönetir; token bilen herkes 'get' edebilir. ----
    match /studentInvites/{token} {
      allow get: if true;
      allow list: if isCoach() && resource.data.coachId == request.auth.uid;
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedUid == request.auth.uid
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data.displayName == resource.data.displayName;
      allow delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    // ---- exerciseCatalog: tüm hocalar+öğrenciler arasında paylaşılan tek egzersiz
    // listesi (video linki + hedef bölge). Hoca normalde sadece OKUR (program
    // atarken seçim listesi için) — yeni kayıt/düzenleme/silme varsayılan olarak
    // YALNIZCA admin'de; admin'in canManageCatalog toggle'ıyla güvendiği belirli
    // hocalara da AYNI yazma izni verilebiliyor (bkz. canManageCatalog()). ----
    match /exerciseCatalog/{exerciseId} {
      allow get, list: if isCoach() || isAdmin() || isManagedStudent();
      allow create, update, delete: if isAdmin() || canManageCatalog();
    }

    // ---- targetRegions: hedef bölge listesi. Okuma (canManageCatalog izni verilen
    // bir hoca, egzersiz kataloğundaki video/hedef-bölge sheet'inin çip listesini
    // doldurmak için) katalog izninden bağımsız kalıyor — o ekran hep okuyabilmeli.
    // YAZMA (ekleme/yeniden adlandırma/arşivleme) admin'de + admin'in AYRI
    // canManageRegions toggle'ıyla güvendiği hocalarda (bkz. canManageRegions()). ----
    match /targetRegions/{regionId} {
      allow get, list: if isAdmin() || canManageCatalog() || canManageRegions();
      allow create, update, delete: if isAdmin() || canManageRegions();
    }

    // ---- notifications: uygulama içi bildirim. Alıcı SADECE kendi bildirimlerini
    // görebiliyor/okundu işaretleyebiliyor; oluşturma sadece gerçek bir hoca↔öğrenci
    // ilişkisi varsa mümkün (isCoachOfStudent / isMyCoach) — rastgele birine bildirim
    // yazılamıyor. Update sadece `read` alanını değiştirebiliyor. ----
    match /notifications/{notifId} {
      // isAdmin() OR'u SADECE type=='system_message' için — admin'in kendi
      // gönderdiği duyuruları geçmiş olarak görüp silebilmesi (bkz.
      // adminCloud.js'teki listMyBroadcasts/deleteBroadcast), bir coach'un
      // öğrencisine yazdığı ÖZEL bir bildirimi okuma/silme yetkisi DEĞİL —
      // admin'in coach↔öğrenci ilişkisi hiç yok, o yüzden bilerek dar tutuldu.
      allow get, list: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid ||
        (isAdmin() && resource.data.type == 'system_message')
      );
      // isAdmin() OR'u SADECE admin'in "Sistem Mesajı Gönder" özelliği için —
      // admin'in coach↔öğrenci ilişkisi yok, bu yüzden hedef HERHANGİ bir uid
      // olabiliyor (tüm coaches+students'a tek tek yazıyor, bkz. adminCloud.js'in
      // broadcastSystemMessage'ı). Mevcut iki dal (isCoachOfStudent/isMyCoach)
      // hiç dokunulmadı.
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && (isCoachOfStudent(request.resource.data.recipientUid) || isMyCoach(request.resource.data.recipientUid) || isAdmin());
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Aynı dar kapsam: admin SADECE kendi system_message duyurularını silebiliyor,
      // bir coach/öğrenci arası bildirimi hiçbir zaman silemiyor.
      allow delete: if isAdmin() && resource.data.type == 'system_message';
    }
  }
}
